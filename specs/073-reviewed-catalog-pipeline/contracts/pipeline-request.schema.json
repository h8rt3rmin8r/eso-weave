{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/h8rt3rmin8r/eso-weave/specs/073/pipeline-request.schema.json",
  "title": "ESO Weave catalog candidate pipeline request",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "mode",
    "version",
    "input_source",
    "source_policy",
    "sources",
    "network",
    "baseline",
    "icon_source",
    "thresholds"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "mode": {
      "enum": ["live", "pts", "offline", "user-capture"]
    },
    "version": { "$ref": "#/$defs/version" },
    "input_source": { "$ref": "#/$defs/id" },
    "source_policy": { "$ref": "#/$defs/relativePath" },
    "sources": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "items": { "$ref": "#/$defs/source" }
    },
    "network": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "refresh", "allow_stale_cache"],
      "properties": {
        "enabled": { "type": "boolean" },
        "refresh": { "type": "boolean" },
        "allow_stale_cache": { "type": "boolean" }
      }
    },
    "baseline": {
      "oneOf": [
        { "type": "null" },
        { "$ref": "#/$defs/relativePath" }
      ]
    },
    "icon_source": {
      "oneOf": [
        { "type": "null" },
        { "$ref": "#/$defs/relativePath" }
      ]
    },
    "thresholds": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "entities_removed",
        "localized_text_removed",
        "relations_removed",
        "coverage_removed",
        "icon_references_removed"
      ],
      "properties": {
        "entities_removed": { "type": "integer", "minimum": 0 },
        "localized_text_removed": { "type": "integer", "minimum": 0 },
        "relations_removed": { "type": "integer", "minimum": 0 },
        "coverage_removed": { "type": "integer", "minimum": 0 },
        "icon_references_removed": { "type": "integer", "minimum": 0 }
      }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024,
      "not": { "pattern": "(^/)|(^[A-Za-z]:)|(^|/)\\.\\.(/|$)|\\\\" }
    },
    "version": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "channel",
        "game_version",
        "api_version",
        "catalog_version",
        "catalog_schema",
        "locales",
        "tool_version"
      ],
      "properties": {
        "channel": { "enum": ["live", "pts"] },
        "game_version": { "type": "string", "pattern": "^[0-9]+(\\.[0-9]+){1,3}$" },
        "api_version": { "type": "integer", "minimum": 1 },
        "catalog_version": { "type": "string", "minLength": 1, "maxLength": 128 },
        "catalog_schema": { "type": "integer", "minimum": 1 },
        "locales": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[A-Za-z]{2,3}(-[A-Za-z0-9]{2,8})?$" }
        },
        "tool_version": { "type": "string", "minLength": 1, "maxLength": 128 }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "role",
        "channel",
        "game_version",
        "api_version",
        "locale",
        "revision",
        "sha256",
        "max_bytes",
        "uri",
        "local_path",
        "license_scope",
        "redistribution"
      ],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "role": {
          "enum": ["normalized-bundle", "collector-capture", "provenance"]
        },
        "channel": { "enum": ["live", "pts", "not-applicable"] },
        "game_version": { "type": "string", "minLength": 1, "maxLength": 64 },
        "api_version": { "type": "integer", "minimum": 0 },
        "locale": { "type": "string", "minLength": 1, "maxLength": 32 },
        "revision": { "type": "string", "minLength": 1, "maxLength": 128 },
        "sha256": { "$ref": "#/$defs/sha256" },
        "max_bytes": { "type": "integer", "minimum": 1, "maximum": 67108864 },
        "uri": { "type": "string", "minLength": 1, "maxLength": 2048 },
        "local_path": {
          "oneOf": [
            { "type": "null" },
            { "$ref": "#/$defs/relativePath" }
          ]
        },
        "license_scope": { "type": "string", "minLength": 1, "maxLength": 512 },
        "redistribution": {
          "enum": [
            "allowed",
            "attribution-required",
            "user-generated-only",
            "prohibited",
            "unresolved"
          ]
        }
      }
    }
  }
}
