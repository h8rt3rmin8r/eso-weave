{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/h8rt3rmin8r/eso-weave/specs/071/collector-envelope.schema.json",
  "title": "ESO Weave bounded collector envelope",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "collector_version",
    "collector_checksum",
    "status",
    "channel",
    "game_version",
    "api_version",
    "locale",
    "platform",
    "megaserver",
    "scope_key",
    "started_at",
    "finished_at",
    "selected_categories",
    "coverage",
    "warnings",
    "checkpoint",
    "chunks"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "collector_version": { "type": "integer", "minimum": 1 },
    "collector_checksum": { "$ref": "#/$defs/sha256" },
    "status": { "enum": ["complete", "paused", "cancelled", "failed"] },
    "channel": { "enum": ["live", "pts"] },
    "game_version": { "type": "string", "minLength": 1, "maxLength": 65536 },
    "api_version": { "type": "integer", "minimum": 1 },
    "locale": { "type": "string", "minLength": 2, "maxLength": 32 },
    "platform": { "type": "string", "minLength": 1, "maxLength": 64 },
    "megaserver": { "type": "string", "maxLength": 64 },
    "scope_key": { "type": "string", "minLength": 1, "maxLength": 128 },
    "started_at": { "type": "string", "minLength": 1, "maxLength": 128 },
    "finished_at": { "type": "string", "maxLength": 128 },
    "selected_categories": {
      "type": "array",
      "minItems": 0,
      "maxItems": 5,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/category" }
    },
    "coverage": {
      "type": "array",
      "minItems": 1,
      "maxItems": 5,
      "items": { "$ref": "#/$defs/coverage" }
    },
    "warnings": {
      "type": "array",
      "maxItems": 1024,
      "items": { "type": "string", "maxLength": 65536 }
    },
    "cancellation_reason": { "type": ["string", "null"], "maxLength": 65536 },
    "checkpoint": { "$ref": "#/$defs/checkpoint" },
    "chunks": {
      "type": "array",
      "maxItems": 1024,
      "items": { "$ref": "#/$defs/chunk" }
    }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "category": {
      "enum": [
        "player-skills",
        "crafted-abilities",
        "item-sets",
        "champion-skills",
        "companions-races-classes"
      ]
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["category", "completeness", "scope", "record_count", "limitations"],
      "properties": {
        "category": { "$ref": "#/$defs/category" },
        "completeness": { "const": "bounded" },
        "scope": { "type": "string", "minLength": 1, "maxLength": 65536 },
        "record_count": { "type": "integer", "minimum": 0, "maximum": 500000 },
        "limitations": { "type": "string", "minLength": 1, "maxLength": 65536 }
      }
    },
    "checkpoint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["adapter", "cursor"],
      "properties": {
        "adapter": { "type": "integer", "minimum": 0, "maximum": 5 },
        "cursor": { "type": "integer", "minimum": 0, "maximum": 500000 }
      }
    },
    "chunk": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sequence", "record_count", "byte_count", "checksum", "payload"],
      "properties": {
        "sequence": { "type": "integer", "minimum": 1, "maximum": 1024 },
        "record_count": { "type": "integer", "minimum": 1, "maximum": 500000 },
        "byte_count": { "type": "integer", "minimum": 1, "maximum": 65536 },
        "checksum": { "type": "string", "pattern": "^[0-9a-f]{8}$" },
        "payload": { "type": "string", "minLength": 1, "maxLength": 65536 }
      }
    }
  }
}
