{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/h8rt3rmin8r/eso-weave/specs/072/icon-cache-manifest.schema.json",
  "title": "ESO Weave local icon cache manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "catalog_semantic_sha256",
    "transformation_id",
    "placeholder_sha256",
    "entries"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "catalog_semantic_sha256": { "$ref": "#/$defs/sha256" },
    "transformation_id": { "const": "rgba8-png-v1" },
    "placeholder_sha256": { "$ref": "#/$defs/sha256" },
    "entries": {
      "type": "array",
      "maxItems": 500000,
      "items": { "$ref": "#/$defs/entry" }
    }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "canonical_path",
        "lookup_key",
        "object_sha256",
        "source_sha256",
        "width",
        "height",
        "media_type",
        "origin",
        "availability",
        "redistribution",
        "fallback_reason"
      ],
      "properties": {
        "canonical_path": { "type": "string", "minLength": 1, "maxLength": 65536 },
        "lookup_key": { "type": "string", "minLength": 1, "maxLength": 65536 },
        "object_sha256": { "$ref": "#/$defs/sha256" },
        "source_sha256": {
          "anyOf": [{ "$ref": "#/$defs/sha256" }, { "type": "null" }]
        },
        "width": { "type": "integer", "minimum": 1, "maximum": 1024 },
        "height": { "type": "integer", "minimum": 1, "maximum": 1024 },
        "media_type": { "const": "image/png" },
        "origin": { "enum": ["user-supplied", "project-placeholder"] },
        "availability": { "enum": ["ready", "placeholder"] },
        "redistribution": { "enum": ["user-local-only", "allowed"] },
        "fallback_reason": {
          "type": ["string", "null"],
          "enum": [null, "missing", "unsupported", "invalid", "permission-denied", "io-failed"]
        }
      }
    }
  }
}
